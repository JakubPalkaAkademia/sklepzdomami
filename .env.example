# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender in Resend
RESEND_FROM=Sklep z domami <onboarding@resend.dev>

# Inbox for contact form submissions
CONTACT_TO_EMAIL=biuro@sklepzdomami.pl

# Comma-separated staff e-mails for booking notifications
BOOKING_NOTIFY_EMAILS=biuro@sklepzdomami.pl

# Neon / Vercel Postgres — run db/schema.sql after provisioning
DATABASE_URL=

# Google Calendar (service account with edit access to the shared calendar)
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Optional: comma-separated e-mails to share the booking calendar with (scripts/share-google-calendar.mjs)
CALENDAR_SHARE_EMAILS=
